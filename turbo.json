{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalEnv": [
    "DATABASE_URL",
    "APP_URL",
    "BETTER_AUTH_SECRET",
    "DATAFORSEO_LOGIN",
    "DATAFORSEO_PASSWORD",
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "MISTRAL_API_KEY",
    "SCRAPE_TARGETS",
    "SEARCHAPI_API_KEY",
    "OLOSTEP_API_KEY",
    "BRIGHTDATA_API_TOKEN",
    "OXYLABS_USERNAME",
    "OXYLABS_PASSWORD",
    "CLORO_API_KEY",
    "OPENROUTER_API_KEY",
    "JINA_API_KEY",
    "ONBOARDING_LLM_TARGET",
    "BEAT_GEO_ENCRYPTION_KEY",
    "BEAT_GEO_ENCRYPTION_KEY_OLD",
    "ADMIN_API_KEYS",
    "DEFAULT_BRAND_DOMAINS",
    "VITE_PLAUSIBLE_DOMAIN",
    "VITE_CLARITY_PROJECT_ID",
    "VITE_POSTHOG_KEY",
    "DISABLE_TELEMETRY",
    "BROWSER_RUNNER_URL",
    "BROWSER_RUNNER_TOKEN",
    "BROWSER_RUNS_DIR",
    "BROWSER_LAB_PORT",
    "BEAT_BROWSER_SPACES",
    "BEAT_BROWSER_PROFILE_ID",
    "BEAT_BROWSER_COMMAND",
    "BEAT_BROWSER_ARGS_JSON",
    "BEAT_GEO_POSTHOG_KEY",
    "BEATAPI_API_KEY",
    "BEATAPI_RESEARCH_MODEL"
  ],
  "tasks": {
    "//#format": {
      "cache": false
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build",
        "check-types"
      ],
      "outputs": [
        ".output/**",
        ".vercel/output/**",
        "dist/**"
      ]
    },
    "@workspace/worker#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "codegen": {
      "outputs": [
        ".source/**"
      ]
    },
    "@workspace/lib#codegen": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/db/schema-auth.ts"
      ],
      "outputs": [
        "src/db/schema-auth.ts"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types",
        "codegen"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
